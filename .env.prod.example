# Copie para .env.prod (ou cole na aba Environment do Dokploy). Nunca versione segredos reais.

# Domínio público da aplicação (sem https:// e sem barra final)
NEXO_DOMAIN=financas.seudominio.com.br

# Senha do banco PostgreSQL interno (gere uma string longa e aleatória, sem caracteres especiais de URL como @ ou /)
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Chave criptográfica do Django
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Controle de novos cadastros (True = aberto para novos usuários; False = bloqueado)
REGISTRATION_ENABLED=True

# Configuração de envio de e-mail (Recuperação de senha via Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=kayronsilva.ofc@gmail.com
# Senha de App do Google (16 letras, sem espaços) gerada em myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=sua-senha-de-app-aqui
DEFAULT_FROM_EMAIL=NEXO <kayronsilva.ofc@gmail.com>

# Dimensionamento do Gunicorn (2 workers x 2 threads é ideal para VPS de 1 a 2 vCPUs / 2 GB RAM)
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Endereço interno do Caddy (:80 quando atrás do Traefik/Dokploy; use o domínio se rodar sem Dokploy)
CADDY_ADDRESS=:80
