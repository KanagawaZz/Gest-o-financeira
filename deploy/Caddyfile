# Configuração global: confia nos ranges privados do Docker (Traefik do Dokploy)
# para preservar X-Forwarded-Proto (https) e X-Forwarded-For reais até o Django.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# No Dokploy, o Traefik gerencia o HTTPS (portas 80/443 da VPS) e encaminha
# o tráfego para este container na porta 80 (padrão: CADDY_ADDRESS=:80).
# Em deploy standalone (sem Dokploy), basta definir CADDY_ADDRESS=seu.dominio.com.br.
{$CADDY_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Fonte (Hanken Grotesk) e foto de fundo são servidas pelo próprio app (sem CDN); Recharts usa estilos inline.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Healthcheck interno do container web
	handle /healthz {
		respond "ok" 200
	}

	# API, painel administrativo e arquivos estáticos do Django
	@backend path /api/* /admin/* /static/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Cache longo para bundles com hash do Vite (/assets/*)
	@ViteAssets path /assets/*
	header @ViteAssets Cache-Control "public, max-age=31536000, immutable"

	# Aplicação (SPA): qualquer outra rota cai no index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
