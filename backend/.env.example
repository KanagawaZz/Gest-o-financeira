# Copie para .env e ajuste. Nunca versione o .env.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vazio = SQLite local (apenas desenvolvimento/testes). Postgres via docker-compose:
# DATABASE_URL=postgres://nexo:nexo@127.0.0.1:5433/nexo
DATABASE_URL=
# True = permite que novos usuários se cadastrem; False = suspende novos cadastros
REGISTRATION_ENABLED=True

# Configuração de envio de e-mail (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=kayronsilva.ofc@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NEXO <kayronsilva.ofc@gmail.com>
FRONTEND_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
